{
  "terminal": {
    "font_family": "Hack Nerd Font"
  },
  "buffer_font_family": "Hack Nerd Font",
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "pi-acp": {
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "gpt-5-mini"
    }
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": true
  },
  "base_keymap": "JetBrains",
  "vim_mode": false,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": "Tokyo Night"
}
